# ============================================================
# NOTE: a "#" only starts a comment at the BEGINNING of a line.
# Never put a comment on the same line as a pattern —
# e.g. `*.json  # comment` is a broken pattern that matches nothing.
# ============================================================

# ============================================================
# SECRETS — never commit these
# ============================================================
.env
.env.*
*.env


# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
__pycache__
.env
.python
.vscode/
.vscode
# Virtual environments
.venv/
venv/
env/

# ============================================================
# RUNTIME STATE — generated while the app runs, never commit
# ============================================================
# Generated vector store (core/storage.py)
data/RAG.json
# Tunable-settings snapshot (settings.save())
data/settings.json
# Conversation memory & session files (memory.py)
conversation_memory.json
sessions/
# Qdrant local / docker storage
qdrant_storage/
# PDF export scratch directory
pdf-forge-exports/

# ============================================================
# EDITORS / IDE
# ============================================================
.vscode/
.vscodium/
.idea/
*.code-workspace

# ============================================================
# OS GARBAGE
# ============================================================
# macOS
.DS_Store
.AppleDouble
# Windows
Thumbs.db
desktop.ini
# Linux
*~

# ============================================================
# LOGS / MISC
# ============================================================
*.log
*.tmp
*.swp


data/*
!data/seed/
data/seed/*
!data/seed/**
THINKING.md

# Generated project-analysis exports
RAG-from-scratch_notebook.ipynb
RAG-from-scratch_report.html
